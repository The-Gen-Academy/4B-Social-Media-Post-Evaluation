# Jev uses TypeSafe directly by default.
JEV_PROVIDER=typesafe
TYPESAFE_API_KEY=
# Optional Vercel AI Gateway: JEV_PROVIDER=gateway, AI_GATEWAY_API_KEY,
# JEV_MODEL=typesafe-ai/jev-1.13.0
AI_GATEWAY_API_KEY=
# Leave blank to use the selected provider's Jev 1.13 model ID.
JEV_MODEL=
# All LLM generation and judging calls use OpenAI directly.
OPENAI_API_KEY=
REVIEW_MODEL=gpt-4.1-mini
