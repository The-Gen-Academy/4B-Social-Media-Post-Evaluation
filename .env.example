# OpenRouter: JEV_PROVIDER=openrouter, OPENROUTER_API_KEY, JEV_MODEL=typesafe/jev-1.13
# Direct TypeSafe: JEV_PROVIDER=typesafe, TYPESAFE_API_KEY, JEV_MODEL=jev-1.13.0
# Vercel AI Gateway: JEV_PROVIDER=gateway, AI_GATEWAY_API_KEY,
# JEV_MODEL=typesafe-ai/jev-1.13.0
JEV_PROVIDER=openrouter
OPENROUTER_API_KEY=
TYPESAFE_API_KEY=
AI_GATEWAY_API_KEY=
# Leave blank to use the selected provider's Jev 1.13 model ID.
JEV_MODEL=
# Advisory review threshold; calibrate against held-out human labels.
JEV_MIN_CONFIDENCE=0.7
